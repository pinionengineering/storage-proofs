<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Storage Proof Study</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
<style>
  html { font-family: system-ui, sans-serif; background: #0f172a; color: #e2e8f0; }
  body { max-width: 1100px; margin: 0 auto; padding: 2rem 1.5rem; }
  h1 { font-size: 1.8rem; font-weight: 700; color: #f1f5f9; margin: 0 0 .25rem; }
  .meta { font-size: .85rem; color: #64748b; margin-bottom: 2rem; }
  h2 { font-size: 1.1rem; font-weight: 600; color: #cbd5e1; margin: 2rem 0 .5rem; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .chart-box {
    background: #1e293b; border: 1px solid #334155; border-radius: .75rem; padding: 1rem;
  }
  .chart-box.full { grid-column: 1 / -1; }
  canvas { width: 100% !important; }
  .legend { display: flex; flex-wrap: wrap; gap: .5rem 1rem; margin-top: .5rem; font-size: .75rem; }
  .legend-item { display: flex; align-items: center; gap: .3rem; }
  .legend-swatch { width: 16px; height: 3px; border-radius: 2px; }
  footer { margin-top: 3rem; font-size: .8rem; color: #475569; }
  a { color: #60a5fa; }
  .cap-table { width: 100%; border-collapse: collapse; font-size: .875rem; margin-top: .5rem; }
  .cap-table th { text-align: left; padding: .5rem .75rem; color: #94a3b8; font-weight: 600;
                  border-bottom: 1px solid #334155; }
  .cap-table td { padding: .5rem .75rem; border-bottom: 1px solid #1e293b; }
  .cap-table tr:last-child td { border-bottom: none; }
  .badge-yes { color: #10b981; font-weight: 700; }
  .badge-no  { color: #64748b; }
</style>
</head>
<body>
<h1>Storage Proof Study</h1>
<p class="meta">Generated {{.Date}} &mdash; solid lines = measured, dashed = theory</p>

<div class="grid">
  <div class="chart-box">
    <h2>Setup time vs. file size</h2>
    <canvas id="tagTime"></canvas>
  </div>
  <div class="chart-box">
    <h2>Prove time vs. challenge size</h2>
    <canvas id="proveTime"></canvas>
  </div>
  <div class="chart-box">
    <h2>Verify time vs. challenge size</h2>
    <canvas id="verifyTime"></canvas>
  </div>
  <div class="chart-box">
    <h2>Challenge wire size vs. challenge size</h2>
    <canvas id="chalBytes"></canvas>
  </div>
  <div class="chart-box">
    <h2>Proof wire size vs. challenge size</h2>
    <canvas id="proofBytes"></canvas>
  </div>
  <div class="chart-box">
    <h2>Setup time vs. RSA key size (Ateniese &amp; Erway)</h2>
    <canvas id="keySweep"></canvas>
  </div>
  <div class="chart-box full">
    <h2>Detection probability vs. corruption fraction</h2>
    <canvas id="detection"></canvas>
  </div>
  <div class="chart-box full">
    <h2>Suite comparison (setup / prove / verify at fixed params)</h2>
    <canvas id="suiteSweep"></canvas>
  </div>
  <div class="chart-box full">
    <h2>Protocol capabilities</h2>
    <table class="cap-table">
      <thead><tr><th>Scheme</th><th>Non-sequential block IDs</th></tr></thead>
      <tbody id="cap-body"></tbody>
    </table>
  </div>
</div>

<footer>
  Source: <a href="https://github.com/pinionengineering/storage-proofs">pinionengineering/storage-proofs</a>.
  Generated by <code>make study</code>.
</footer>

<script>
const DATA = {{.DataJSON}};

Chart.defaults.color = '#94a3b8';
Chart.defaults.borderColor = '#1e293b';

function lineDatasets(chart) {
  return chart.series.map(s => ({
    label: s.label,
    data: s.points.map(p => ({x: p.x, y: p.y})),
    borderColor: s.color,
    backgroundColor: s.color + '22',
    borderDash: s.dash ? [6, 4] : [],
    pointRadius: s.dash ? 0 : 4,
    pointHoverRadius: s.dash ? 0 : 6,
    tension: 0.3,
    fill: false,
  }));
}

function makeLineChart(id, chart) {
  new Chart(document.getElementById(id), {
    type: 'line',
    data: { datasets: lineDatasets(chart) },
    options: {
      responsive: true,
      parsing: false,
      scales: {
        x: { type: 'linear', title: { display: true, text: chart.xlabel } },
        y: { title: { display: true, text: chart.ylabel } },
      },
      plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, padding: 10 } } },
    },
  });
}

function makeSuiteChart(id, sweep) {
  const colors = { Setup: '#64748b', Prove: '#3b82f6', Verify: '#10b981' };
  const groups = [sweep.setup[0], sweep.prove[0], sweep.verify[0]];
  new Chart(document.getElementById(id), {
    type: 'bar',
    data: {
      labels: sweep.schemes,
      datasets: groups.map(g => ({
        label: g.label,
        data: g.values,
        backgroundColor: colors[g.label] ?? g.color,
      })),
    },
    options: {
      responsive: true,
      scales: { y: { title: { display: true, text: 'Time (µs)' } } },
      plugins: { legend: { position: 'bottom' } },
    },
  });
}

const c = DATA.charts;
makeLineChart('tagTime',    c.tagTime);
makeLineChart('proveTime',  c.proveTime);
makeLineChart('verifyTime', c.verifyTime);
makeLineChart('chalBytes',  c.chalBytes);
makeLineChart('proofBytes', c.proofBytes);
makeLineChart('keySweep',   c.keySweep);
makeLineChart('detection',  c.detection);
makeSuiteChart('suiteSweep', c.suiteSweep);

(function() {
  const tbody = document.getElementById('cap-body');
  DATA.capabilities.forEach(cap => {
    const tr = document.createElement('tr');
    tr.innerHTML =
      `<td><span style="color:${cap.color}">&#9632;</span> ${cap.name}</td>` +
      `<td class="${cap.sparse_blocks ? 'badge-yes' : 'badge-no'}">${cap.sparse_blocks ? '✓ yes' : '✗ no'}</td>`;
    tbody.appendChild(tr);
  });
})();
</script>
</body>
</html>
